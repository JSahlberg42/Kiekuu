rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own document on signup
      allow create: if isOwner(userId) && 
                      request.resource.data.role == 'user' &&
                      request.resource.data.rank == 'harjoittelija';
      
      // Self-service updates are limited to profile/account-linking fields.
      // teamId changes go exclusively through joinTeam/leaveTeam Cloud Functions —
      // direct client updates would desync /users/{userId}.teamId from
      // /teams/{teamId}.memberUids. Progression state (progress,
      // progressByCategory, rank*) is written exclusively by the submitQuizAnswer
      // Cloud Function, so scores and ranks cannot be forged from the client.
      allow update: if isOwner(userId) &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                        ['displayName', 'photoURL', 'email', 'isAnonymous', 'linkedAt', 'consentToTeamVisibility']
                      );
      
      // Admins have full update access (role management, moderation)
      allow update: if isAdmin();
      
      // No deletions allowed
      allow delete: if false;
      
      // User answers subcollection - created by submitQuizAnswer only,
      // immutable afterwards
      match /answers/{answerId} {
        // Users can read their own answers
        allow read: if isOwner(userId);
        
        // No client writes; server writes via Admin SDK bypass rules
        allow create, update, delete: if false;
      }
    }
    
    // Questions collection
    match /questions/{questionId} {
      // Everyone can read questions (when authenticated)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete questions
      allow create, update, delete: if isAdmin();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      // Everyone can read categories
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }
    
    // Ranks collection
    match /ranks/{rankId} {
      // Everyone can read ranks
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }
    
    // Platform configuration
    match /config/{configId} {
      // Everyone can read configuration
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }

    // Feedback collection
    // Creates go through the submitFeedback callable function, which enforces
    // App Check, authentication and per-user rate limits. Direct client writes
    // are denied.
    match /feedback/{feedbackId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
    
    // Leaderboard collection (anonymous scoreboard, Layer 1).
    // Documents are keyed by uid; only server-written score/rank/lastUpdated
    // fields. No PII (no displayName, email, photo). All authenticated users
    // may read all entries; writes are denied client-side and performed by
    // the syncLeaderboard Cloud Function.
    match /leaderboard/{uid} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Teams collection (VPK-friendly competition groups).
    // Documents: TeamDoc — name, createdBy, totalScore (server-maintained),
    // memberUids array (capped at 50), memberCount.
    // Reads: any authenticated user may list/browse teams.
    // Writes: only via Cloud Functions (create/join/leave) — clients cannot
    // manipulate team membership directly.
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
