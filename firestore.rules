rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    // Users collection
    match /users/{userId} {
      // Single-document reads: owner or admin.
      // Collection-list queries are allowed only for admins.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Users can create their own document on signup.
      // Field-level restrictions prevent injection of privileged fields (score,
      // progress, rank, role, teamId) that would survive the update guard.
      // Note: 'progress' and 'teamId' are server-only fields written exclusively
      // by Cloud Functions — blocking them here prevents malicious clients from
      // pre-poisoning documents at creation time.
      allow create: if isOwner(userId) && 
                      request.resource.data.role == 'user' &&
                      request.resource.data.rank == 'harjoittelija' &&
                      request.resource.data.keys().hasOnly([
                        'uid', 'email', 'displayName', 'photoURL',
                        'isAnonymous', 'role', 'rank', 'createdAt',
                        'consentToTeamVisibility'
                      ]) &&
                      // isAnonymous: optional bool (Firestore uses 'bool')
                      (!('isAnonymous' in request.resource.data) ||
                       request.resource.data.isAnonymous is bool) &&
                      // displayName: nullable string, 1-100 chars if present
                      (!('displayName' in request.resource.data) ||
                       (request.resource.data.displayName is string &&
                        request.resource.data.displayName.size() >= 1 &&
                        request.resource.data.displayName.size() <= 100)) &&
                      // photoURL: optional string, valid URL if present, max 500 chars
                      (!('photoURL' in request.resource.data) ||
                       (request.resource.data.photoURL is string &&
                        request.resource.data.photoURL.matches('^https?://.+$') &&
                        request.resource.data.photoURL.size() <= 500)) &&
                      // email: optional string, basic format + length if present
                      (!('email' in request.resource.data) ||
                       (request.resource.data.email is string &&
                        request.resource.data.email.matches('^.+@.+$') &&
                        request.resource.data.email.size() <= 254)) &&
                      // consentToTeamVisibility: optional bool
                      (!('consentToTeamVisibility' in request.resource.data) ||
                       request.resource.data.consentToTeamVisibility is bool);
      
      // Self-service updates are limited to profile/account-linking fields.
      // teamId changes go exclusively through joinTeam/leaveTeam Cloud Functions —
      // direct client updates would desync /users/{userId}.teamId from
      // /teams/{teamId}.memberUids. Progression state (progress,
      // progressByCategory, rank*) is written exclusively by the submitQuizAnswer
      // Cloud Function, so scores and ranks cannot be forged from the client.
      allow update: if isOwner(userId) &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                        ['displayName', 'photoURL', 'email', 'isAnonymous', 'linkedAt', 'consentToTeamVisibility']
                      ) &&
                      // displayName: nullable string, 1-100 chars if present
                      (!('displayName' in request.resource.data) ||
                       (request.resource.data.displayName is string &&
                        request.resource.data.displayName.size() >= 1 &&
                        request.resource.data.displayName.size() <= 100)) &&
                      // photoURL: optional string, valid URL if present, max 500 chars
                      (!('photoURL' in request.resource.data) ||
                       (request.resource.data.photoURL is string &&
                        request.resource.data.photoURL.matches('^https?://.+$') &&
                        request.resource.data.photoURL.size() <= 500)) &&
                      // email: optional string, basic format + length if present
                      (!('email' in request.resource.data) ||
                       (request.resource.data.email is string &&
                        request.resource.data.email.matches('^.+@.+$') &&
                        request.resource.data.email.size() <= 254)) &&
                      // isAnonymous: optional bool
                      (!('isAnonymous' in request.resource.data) ||
                       request.resource.data.isAnonymous is bool) &&
                      // linkedAt: optional ISO timestamp string, max 50 chars
                      (!('linkedAt' in request.resource.data) ||
                       (request.resource.data.linkedAt is string &&
                        request.resource.data.linkedAt.size() <= 50)) &&
                      // consentToTeamVisibility: optional bool
                      (!('consentToTeamVisibility' in request.resource.data) ||
                       request.resource.data.consentToTeamVisibility is bool);
      
      // Admins have full update access (role management, moderation)
      allow update: if isAdmin();
      
      // No deletions allowed
      allow delete: if false;
      
      // User answers subcollection - created by submitQuizAnswer only,
      // immutable afterwards
      match /answers/{answerId} {
        // Users can read their own answers
        allow read: if isOwner(userId);
        
        // No client writes; server writes via Admin SDK bypass rules
        allow create, update, delete: if false;
      }
    }
    
    // Questions collection
    match /questions/{questionId} {
      // Everyone can read questions (when authenticated)
      allow read: if isAuthenticated();
      
      // Only admins can create/update/delete questions
      allow create, update, delete: if isAdmin();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      // Everyone can read categories
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }
    
    // Ranks collection
    match /ranks/{rankId} {
      // Everyone can read ranks
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }
    
    // Platform configuration
    match /config/{configId} {
      // Everyone can read configuration
      allow read: if isAuthenticated();
      
      // Only admins can modify
      allow create, update, delete: if isAdmin();
    }

    // Feedback collection
    // Creates go through the submitFeedback callable function, which enforces
    // App Check, authentication and per-user rate limits. Direct client writes
    // are denied.
    match /feedback/{feedbackId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
    
    // Leaderboard collection (anonymous scoreboard, Layer 1).
    // Documents are keyed by uid; only server-written score/rank/lastUpdated
    // fields. No PII (no displayName, email, photo). All authenticated users
    // may read all entries; writes are denied client-side and performed by
    // the syncLeaderboard Cloud Function.
    match /leaderboard/{uid} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Teams collection (VPK-friendly competition groups).
    // Documents: TeamDoc — name, createdBy, totalScore (server-maintained),
    // memberUids array (capped at 50), memberCount.
    // Reads: any authenticated user may list/browse teams.
    // Writes: only via Cloud Functions (create/join/leave) — clients cannot
    // manipulate team membership directly.
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}